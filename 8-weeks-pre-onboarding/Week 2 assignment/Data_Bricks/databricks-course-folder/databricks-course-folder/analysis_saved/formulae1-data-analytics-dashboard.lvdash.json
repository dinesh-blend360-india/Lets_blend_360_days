    {
      "name": "ba3f7069",
      "displayName": "Dominent drivers of all time",
      "queryLines": [
        "\r\n",
        "with metrices as (\r\n",
        "select driver_name, \r\n",
        "sum(race_starts) as race_starts,    \r\n",
        "sum(number_of_wins) as number_of_wins, \r\n",
        "sum(number_of_podiums) as number_of_podium,\r\n",
        "sum(case when standing=1 then 1 else 0 end) total_champions\r\n",
        "from \r\n",
        "formulae1.gold.drivers_standing\r\n",
        "\r\n",
        "group by driver_name \r\n",
        "having total_champions>=1\r\n",
        "\r\n",
        ")\r\n",
        "select driver_name, race_starts, number_of_wins, number_of_podium, total_champions, \r\n",
        "(total_champions * 100) + (number_of_wins *10) + (number_of_podium * 3)  as greatness_score from metrices order by greatness_score limit 10;\r\n"
      ]
    },
    {
      "name": "aac519dd",
      "displayName": "Dominant Constructors",
      "queryLines": [
        "\r\n",
        "with constructor_metrices as (\r\n",
        "select constructor_name, \r\n",
        "sum(race_starts) as race_starts,    \r\n",
        "sum(number_of_wins) as number_of_wins, \r\n",
        "sum(number_of_podiums) as number_of_podium,\r\n",
        "sum(case when standing=1 then 1 else 0 end) total_champions\r\n",
        "from \r\n",
        "formulae1.gold.onstructors_standing\r\n",
        "\r\n",
        "group by constructor_name \r\n",
        "having total_champions>=1\r\n",
        "\r\n",
        ")\r\n",
        "select constructor_name, race_starts, number_of_wins, number_of_podium, total_champions, (total_champions * 100) + (number_of_wins *10) + (number_of_podium * 3)  as greatness_score from constructor_metrices order by greatness_score;\r\n"
      ]
    }
  ],
