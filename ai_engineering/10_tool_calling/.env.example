OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
MAX_TOOL_ROUNDS=3

# day07 uses the existing index. mock must be selected explicitly and returns
# clearly labelled demonstration data from data/mock_knowledge.json.
KNOWLEDGE_BACKEND=day07
DAY07_PROJECT_DIR=..\7_rag
DAY06_INDEX_DIR=..\6_embedding_and_retrival\outputs\embeddings\employee_policy_md_structure
MOCK_KNOWLEDGE_FILE=data\mock_knowledge.json

# Application-owned identity and permission; models cannot set these fields.
APP_ACTOR_ID=local-demo-user
ALLOW_SERVICE_REQUEST_CREATE=false

SERVICE_REQUEST_DIR=outputs\actions
TOOL_LOG_FILE=outputs\logs\tool_execution.jsonl
