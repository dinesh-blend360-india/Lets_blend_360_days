# Day 16 — observability. Copy to ../.env (the shared file) or set in your shell.
# Tracing works with none of these set: the local file backend is the default.

# ── LangSmith (optional) ───────────────────────────────────────────────
# With these unset, traces are written only to outputs/traces/ as JSONL.
# Never commit a real key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=day16-observability

# ── Deliberate faults (off by default) ─────────────────────────────────
# One of: slow_tool | flaky_tool | mcp_error | bad_retrieval | prompt_bloat
# Leave empty for normal behaviour. The CLI --fault flag overrides this.
FAULT=

# ── Model (inherited from Day 10) ──────────────────────────────────────
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
